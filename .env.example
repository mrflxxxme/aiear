# AIEAR — пример env. Скопируй в .env (в .gitignore) и заполни.
# НИКОГДА не коммить реальные значения (CLAUDE.md §3, reviewer-security гейт).

# --- ИИ-пайплайн (backend, RF-стек) ---
YANDEX_SPEECHKIT_API_KEY=
YANDEX_CLOUD_FOLDER_ID=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
SALUTESPEECH_API_KEY=            # fallback STT/TTS

# --- Хранилище (RF-облако, ФЗ-242) ---
RF_OBJECT_STORAGE_ENDPOINT=
RF_OBJECT_STORAGE_KEY=
RF_OBJECT_STORAGE_SECRET=
POSTGRES_DSN=postgresql://user:pass@localhost:5432/aiear
REDIS_URL=redis://localhost:6379/0

# --- Платежи (MVP-1) ---
RUSTORE_PAY_MERCHANT_ID=
RUSTORE_PAY_KEY=
ACQUIRER_PROVIDER=cloudpayments  # cloudpayments | yookassa
ACQUIRER_PUBLIC_ID=
ACQUIRER_API_SECRET=

# --- Интеграции (MVP-0 F3) ---
TELEGRAM_BOT_TOKEN=              # для destination «Telegram»

# --- Агентная телеметрия (опц., claude-flow MCP / AgentDB) ---
AGENTDB_PATH=.agentdb/aiear.db
# LANGFUSE_HOST=                 # если включаем cost-телеметрию
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

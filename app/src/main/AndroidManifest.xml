<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Audio capture for the thought-catcher (foreground only). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Foreground service + the Android 14+ microphone subtype. The microphone
         subtype is the ONLY ADR-002-legal path to background mic capture. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Required (API 33+) to show the ongoing FGS notification (S1-AC2). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- S2: CompanionDeviceManager background autostart on BT headphone connect.
         BLUETOOTH_CONNECT (runtime, API 31+) to resolve the associated device;
         REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND (API 34) legalises raising
         the mic-FGS from CompanionCaptureService.onDeviceAppeared while in the background —
         the ONLY ADR-002-legal background start path. -->
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="true" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />

    <!--
      ADR-002 hard bans — deliberately ABSENT (their absence is a conformance signal):
        * NO <receiver> for android.intent.action.BOOT_COMPLETED  (banned mic auto-start, Android 14+)
        * NO AccessibilityService                                  (Play-banned automation)
        * NO silent-audio / Now Playing hack
      The only legal start surface is startForegroundService() from the foreground MainActivity.
    -->

    <application
        android:name=".AiearApp"
        android:allowBackup="false"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AIEAR">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AIEAR">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Mic foreground service. exported=false: started only in-process from the
             foreground Activity (ADR-002). foregroundServiceType=microphone is required
             on Android 14+ and must match the ServiceCompat.startForeground type. -->
        <service
            android:name=".capture.service.MicForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- S2: CDM presence-observation service. The system binds it
             (BIND_COMPANION_DEVICE_SERVICE) and calls onDeviceAppeared / onDeviceDisappeared for
             associated + observed devices. exported=true is required for the system to bind it;
             the BIND permission restricts the binder to the OS. This is the legal background
             trigger that raises the mic-FGS on headphone connect. -->
        <service
            android:name=".capture.companion.CompanionCaptureService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

    </application>

</manifest>
